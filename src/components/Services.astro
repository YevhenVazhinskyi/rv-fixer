---
import { services, ui } from "../data/site";
---

<section id="services" class="py-20 md:py-28 bg-slate-950 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-14">
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
        {ui.services.title}
      </h2>
      <p class="text-slate-400 text-lg">{ui.services.subtitle}</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="group rounded-2xl border border-white/10 bg-slate-900/80 p-6 hover:border-brand-500/40 hover:bg-slate-900 transition-all">
            <span class="text-3xl mb-4 block" aria-hidden="true">{service.icon}</span>
            <h3 class="font-display text-xl font-bold text-white mb-2 group-hover:text-brand-300 transition-colors">
              {service.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed">{service.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-12">
      <a
        href="#contact"
        class="inline-flex items-center px-7 py-4 text-base font-semibold text-slate-950 bg-brand-400 rounded-lg hover:bg-brand-300 transition-colors"
      >
        {ui.services.cta}
      </a>
    </div>
  </div>
</section>
