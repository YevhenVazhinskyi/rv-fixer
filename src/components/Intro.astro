---
import { intro } from "../data/site";
---

<section class="py-20 md:py-24 bg-white border-y border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-[1fr_1.2fr] gap-10 md:gap-16 items-center">
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-950 leading-tight">
        {intro.heading}
      </h2>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed border-l-4 border-brand-500 pl-6">
        {intro.body}
      </p>
    </div>
  </div>
</section>
