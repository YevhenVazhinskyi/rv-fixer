---
import { appointmentTimeRanges, ui } from "../data/site";

const weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
---

<fieldset class="rounded-xl bg-white/95 shadow-sm border border-slate-200/80 p-5 sm:p-6 space-y-5">
  <legend class="sr-only">{ui.contact.appointmentTitle}</legend>
  <div>
    <h3 class="text-left text-slate-900 font-semibold text-lg">{ui.contact.appointmentTitle}</h3>
    <p class="text-left text-sm text-slate-600 mt-1 leading-relaxed">{ui.contact.appointmentNote}</p>
  </div>

  <div>
    <p id="calendar-hint" class="text-left text-sm font-medium text-slate-800 mb-3">{ui.contact.calendarHint}</p>
    <div
      class="appointment-calendar rounded-lg border border-slate-200 bg-slate-50 p-3 sm:p-4"
      data-weekdays={JSON.stringify(weekdayLabels)}
    >
      <div class="flex items-center justify-between gap-2 mb-3">
        <button
          type="button"
          class="cal-nav px-3 py-1.5 text-sm font-semibold text-slate-700 rounded-md hover:bg-white border border-transparent hover:border-slate-200 transition-colors"
          data-dir="-1"
          aria-label="Previous month"
        >
          ‹
        </button>
        <p class="cal-month-label text-sm sm:text-base font-semibold text-slate-900 tabular-nums" aria-live="polite"></p>
        <button
          type="button"
          class="cal-nav px-3 py-1.5 text-sm font-semibold text-slate-700 rounded-md hover:bg-white border border-transparent hover:border-slate-200 transition-colors"
          data-dir="1"
          aria-label="Next month"
        >
          ›
        </button>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-slate-500 mb-1">
        {weekdayLabels.map((d) => <span class="py-1">{d}</span>)}
      </div>
      <div class="cal-days grid grid-cols-7 gap-1"></div>
    </div>
    <input type="hidden" name="preferred_date" id="preferred_date" required />
    <p class="cal-selected text-left text-sm text-brand-700 font-medium mt-2 min-h-[1.25rem]" aria-live="polite"></p>
  </div>

  <div>
    <label for="preferred_time_range" class="block text-left text-slate-800 font-medium mb-2">
      {ui.contact.timeRangeLabel}
    </label>
    <select
      id="preferred_time_range"
      name="preferred_time_range"
      required
      class="w-full px-5 py-4 bg-white text-slate-800 shadow-sm border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500"
    >
      <option value="" disabled selected>{ui.contact.timeRangePlaceholder}</option>
      {appointmentTimeRanges.map((range) => <option value={range.value}>{range.label}</option>)}
    </select>
  </div>

  <input type="hidden" name="preferred_appointment" id="preferred_appointment" />
</fieldset>

<script>
  const root = document.querySelector(".appointment-calendar");
  if (root instanceof HTMLElement) {
    const weekdays = JSON.parse(root.dataset.weekdays ?? "[]") as string[];
    const monthLabel = root.querySelector(".cal-month-label");
    const daysEl = root.querySelector(".cal-days");
    const hiddenDate = document.getElementById("preferred_date") as HTMLInputElement | null;
    const hiddenSummary = document.getElementById("preferred_appointment") as HTMLInputElement | null;
    const selectedEl = root.parentElement?.querySelector(".cal-selected");
    const timeSelect = document.getElementById("preferred_time_range") as HTMLSelectElement | null;

    let viewYear: number;
    let viewMonth: number;
    let selectedIso: string | null = null;

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    function startOfMonth(y: number, m: number) {
      return new Date(y, m, 1);
    }

    function toIso(d: Date) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${day}`;
    }

    function formatDisplay(iso: string) {
      const [y, m, d] = iso.split("-").map(Number);
      return new Date(y, m - 1, d).toLocaleDateString(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric",
      });
    }

    function syncSummary() {
      if (!hiddenSummary || !timeSelect) return;
      const rangeText = timeSelect.selectedOptions[0]?.text ?? "";
      if (selectedIso && rangeText && timeSelect.value) {
        hiddenSummary.value = `${formatDisplay(selectedIso)} · ${rangeText}`;
      } else if (selectedIso) {
        hiddenSummary.value = formatDisplay(selectedIso);
      } else {
        hiddenSummary.value = "";
      }
    }

    function render() {
      if (!daysEl || !monthLabel) return;
      const first = startOfMonth(viewYear, viewMonth);
      monthLabel.textContent = first.toLocaleDateString(undefined, { month: "long", year: "numeric" });

      daysEl.innerHTML = "";
      const startPad = first.getDay();
      for (let i = 0; i < startPad; i++) {
        const pad = document.createElement("span");
        pad.setAttribute("aria-hidden", "true");
        daysEl.appendChild(pad);
      }

      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      for (let day = 1; day <= daysInMonth; day++) {
        const cellDate = new Date(viewYear, viewMonth, day);
        cellDate.setHours(0, 0, 0, 0);
        const iso = toIso(cellDate);
        const isPast = cellDate < today;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = String(day);
        btn.dataset.date = iso;
        btn.className =
          "cal-day min-h-[2.25rem] rounded-md text-sm font-medium transition-colors " +
          (isPast
            ? "text-slate-300 cursor-not-allowed"
            : "text-slate-800 hover:bg-white hover:ring-1 hover:ring-brand-300");
        if (isPast) btn.disabled = true;
        if (selectedIso === iso) {
          btn.className =
            "cal-day min-h-[2.25rem] rounded-md text-sm font-semibold bg-brand-600 text-white ring-2 ring-brand-400";
        }
        if (!isPast) {
          btn.addEventListener("click", () => {
            selectedIso = iso;
            if (hiddenDate) {
              hiddenDate.value = iso;
              hiddenDate.dispatchEvent(new Event("input", { bubbles: true }));
            }
            if (selectedEl) selectedEl.textContent = `Selected: ${formatDisplay(iso)}`;
            render();
            syncSummary();
          });
        }
        daysEl.appendChild(btn);
      }
    }

    viewYear = today.getFullYear();
    viewMonth = today.getMonth();
    render();

    root.querySelectorAll(".cal-nav").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = Number((btn as HTMLElement).dataset.dir);
        viewMonth += dir;
        if (viewMonth > 11) {
          viewMonth = 0;
          viewYear += 1;
        } else if (viewMonth < 0) {
          viewMonth = 11;
          viewYear -= 1;
        }
        render();
      });
    });

    timeSelect?.addEventListener("change", syncSummary);

    const form = root.closest("form");
    form?.addEventListener("submit", (e) => {
      if (!hiddenDate?.value) {
        e.preventDefault();
        if (selectedEl) selectedEl.textContent = "Please pick a day on the calendar.";
        document.getElementById("calendar-hint")?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      syncSummary();
    });
  }
</script>
