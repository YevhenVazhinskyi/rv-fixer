---
import { site, ui, stats } from "../data/site";
import FormIcon from "./icons/FormIcon.astro";
---

<section class="relative min-h-[92vh] flex items-center pt-20 overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0 hero-grid"></div>
  <div class="absolute -top-32 -right-32 h-[28rem] w-[28rem] rounded-full bg-brand-500/25 blur-3xl animate-pulse"></div>
  <div class="absolute bottom-0 left-0 h-80 w-80 rounded-full bg-accent-500/15 blur-3xl"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-brand-600/10 blur-3xl"></div>

  <div class="absolute inset-0 hero-scenery opacity-40"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-950/95 to-brand-950/80"></div>
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-slate-950 to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-24 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <span class="inline-block mb-6 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-300 bg-brand-500/10 border border-brand-500/30 rounded-full">
          {ui.hero.badge}
        </span>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold leading-[1.05] mb-6 text-balance bg-gradient-to-r from-white via-white to-brand-400 bg-clip-text text-transparent">
          {site.tagline}
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-xl mb-4 leading-relaxed">
          {site.description}
        </p>
        <p class="text-brand-300 font-semibold mb-10 max-w-xl">{ui.hero.promo}</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4 mb-10 lg:mb-0">
          <div class="flex items-center gap-4 flex-wrap">
            <a
              href={`tel:${site.phoneRaw}`}
              class="inline-flex items-center justify-center px-7 py-4 text-base font-semibold text-slate-950 bg-brand-400 rounded-lg hover:bg-brand-300 hover:scale-[1.02] transition-all shadow-lg shadow-brand-500/20"
            >
              Call {site.phone}
            </a>
            <span class="text-lg font-semibold text-brand-200">{site.ownerName}</span>
          </div>
          <a
            href={site.bookingUrl}
            class="inline-flex items-center justify-center gap-3 px-7 py-4 text-left text-white border border-white/25 rounded-lg hover:bg-white/10 hover:border-brand-400/50 transition-all"
          >
            <FormIcon class="w-7 h-7 shrink-0 text-brand-400" />
            <span class="flex flex-col leading-tight">
              <span class="text-base font-semibold">{ui.hero.ctaFormTitle}</span>
              <span class="text-sm font-normal text-brand-200">{ui.hero.ctaFormSubtitle}</span>
            </span>
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src={site.logo}
          alt={`${site.shortName} — ${site.legalName}, ${ui.hero.badge}`}
          class="w-full max-w-[320px] sm:max-w-[380px] rounded-2xl shadow-2xl shadow-black/50 ring-1 ring-white/10"
          width="380"
          height="380"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mt-14">
      {
        stats.map((stat) => (
          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4 card-shine backdrop-blur-sm hover:border-brand-500/30 transition-colors">
            <p class="font-display text-xl font-bold text-brand-300">
              {
                "compareAt" in stat && stat.compareAt ? (
                  <>
                    <span class="text-slate-500 line-through decoration-2 font-semibold text-lg mr-1.5">
                      {stat.compareAt}
                    </span>
                    {stat.value}
                  </>
                ) : (
                  stat.value
                )
              }
            </p>
            <p class="text-sm text-slate-400 mt-1">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
