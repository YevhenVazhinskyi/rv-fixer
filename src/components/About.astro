---
import { about, whyUs, ui } from "../data/site";
---

<section id="about" class="py-20 md:py-28 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">
      <div>
        <p class="text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{ui.about.title}</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-slate-950 mb-6 leading-tight">
          {about.heading}
        </h2>
        {
          about.paragraphs.map((paragraph) => (
            <p class="text-slate-600 leading-relaxed mb-4 last:mb-0">{paragraph}</p>
          ))
        }
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {
          whyUs.map((item) => (
            <article class="rounded-xl bg-slate-50 border border-slate-200 p-5">
              <h3 class="font-display font-bold text-slate-950 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
