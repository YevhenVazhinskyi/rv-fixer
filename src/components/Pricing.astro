---
import { pricing, ui, site } from "../data/site";
---

<section id="pricing" class="py-20 md:py-28 bg-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-slate-950 mb-4">
        {ui.pricing.title}
      </h2>
      <p class="text-slate-600 text-lg">{ui.pricing.subtitle}</p>
    </div>

    <article class="max-w-2xl mx-auto mb-8 rounded-2xl bg-slate-950 text-white ring-2 ring-brand-500 shadow-xl p-8 md:p-10 text-center">
      <div class="text-5xl mb-4" aria-hidden="true">🚐</div>
      <h3 class="font-display text-2xl font-bold mb-6">{ui.pricing.serviceCallHeading}</h3>

      <div class="grid sm:grid-cols-2 gap-4 mb-6 text-left">
        <div class="rounded-xl bg-white/5 border border-white/10 px-5 py-4">
          <p class="text-sm uppercase tracking-wider text-slate-400 mb-1">King County</p>
          <p class="text-3xl font-bold text-brand-400">{site.serviceCallKingCounty}</p>
          <p class="text-slate-400 text-xs mt-1">service call</p>
        </div>
        <div class="rounded-xl bg-white/5 border border-white/10 px-5 py-4">
          <p class="text-sm uppercase tracking-wider text-slate-400 mb-1">Snohomish County</p>
          <p class="text-3xl font-bold text-brand-400">{site.serviceCallSnohomish}</p>
          <p class="text-slate-400 text-xs mt-1">service call</p>
        </div>
      </div>
      <p class="text-slate-400 text-xs mb-6">{ui.pricing.snohomishNote}</p>

      <div class="border-t border-white/10 pt-6 mb-6">
        <p class="text-sm font-medium text-brand-300 mb-3">{ui.pricing.nearSeattleLabel}</p>
        <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
          <span class="text-2xl font-bold text-slate-400 line-through decoration-2 decoration-slate-500">
            {site.serviceCallKingCounty}
          </span>
          <span class="text-4xl font-bold text-brand-400">{site.serviceCallNearSeattle}</span>
          <span class="text-slate-400 text-sm">service call</span>
        </div>
        <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
          {site.freeServiceCities.join(" · ")}
        </p>
      </div>

      <div class="rounded-xl bg-brand-500/10 border border-brand-500/30 px-5 py-4 text-left">
        <p class="text-sm uppercase tracking-wider text-brand-300 mb-2">{ui.pricing.mileageLabel}</p>
        <p class="text-2xl font-bold text-white">
          +{site.mileageExtraPerMile}<span class="text-lg font-semibold text-slate-300"> / mile</span>
        </p>
        <p class="text-slate-400 text-sm mt-2 leading-relaxed">
          Applies when your RV is more than {site.mileageFromSeattleIncluded} miles from Seattle (added to the service call).
        </p>
      </div>
    </article>

    <div class="grid gap-6 sm:grid-cols-2 max-w-2xl mx-auto">
      {
        pricing.map((item) => (
          <article class="rounded-2xl p-7 bg-white border border-slate-200 text-slate-800">
            <h3 class="font-display text-xl font-bold mb-2">{item.title}</h3>
            <p class="text-3xl font-bold text-brand-600 mb-3">{item.price}</p>
            <p class="text-sm leading-relaxed text-slate-600">{item.note}</p>
          </article>
        ))
      }
    </div>

    <p class="text-center text-sm text-slate-500 mt-10 max-w-2xl mx-auto">{ui.pricing.disclaimer}</p>

    <div class="text-center mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={`tel:${site.phoneRaw}`}
        class="inline-flex items-center px-7 py-3 text-sm font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-500 transition-colors"
      >
        {ui.pricing.cta} · {site.phone}
      </a>
      <a
        href="#contact"
        class="inline-flex items-center px-7 py-3 text-sm font-semibold text-slate-950 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
      >
        Service Request · Pre-estimate
      </a>
    </div>
  </div>
</section>
