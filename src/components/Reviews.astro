---
import { reviews, site, ui } from "../data/site";
---

<section id="reviews" class="py-20 md:py-28 bg-slate-950 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-4">
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
        {ui.reviews.title}
      </h2>
      <p class="text-slate-400">{ui.reviews.subtitle}</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto mb-12">
      {
        reviews.map((review) => (
          <article class="rounded-2xl border border-white/10 bg-slate-900/60 p-6">
            <div class="flex gap-1 mb-4" aria-label={`${review.rating} out of 5 stars`}>
              {Array.from({ length: review.rating }).map(() => (
                <svg class="w-4 h-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-slate-300 leading-relaxed mb-4 text-sm italic">"{review.text}"</p>
            <p class="text-xs font-medium text-slate-500">
              — {review.author}
              <span class="text-slate-600"> · {ui.reviews.sourceLabel}</span>
            </p>
          </article>
        ))
      }
    </div>

    <div class="text-center">
      <a
        href={site.googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-7 py-3 text-sm font-semibold text-slate-950 bg-brand-400 rounded-lg hover:bg-brand-300 transition-colors"
      >
        {ui.reviews.cta}
      </a>
    </div>
  </div>
</section>
